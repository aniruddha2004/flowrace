# ── Flow Race secrets ─────────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit .env.local (gitignored).

# ── LLM provider (OpenAI-compatible chat completions) ────────────────────────
# Key resolution order: LLM_API_KEY ?? JUSPAY_API_KEY ?? ANTHROPIC_API_KEY
# LLM_API_KEY=
# JUSPAY_API_KEY=
# ANTHROPIC_API_KEY=            # https://console.anthropic.com
# LLM_BASE_URL=https://grid.ai.juspay.net
# LLM_MODEL=kimi-k3

# ── TypeSafe Jev (System One) — required for Flow B ──────────────────────────
# Get a key: https://console.typesafe.ai/keys
# TYPESAFE_API_KEY=

# ── Dataset evaluation cost guard ────────────────────────────────────────────
# Require explicit confirmation when estimated total cost exceeds this amount.
# EVAL_CONFIRM_THRESHOLD_USD=2

# ── Pricing ──────────────────────────────────────────────────────────────────
# Model rates are edited in the model registry and stored in SQLite. Seeded
# models start with approximate point-in-time USD per 1M token rates.
